    "    <td>3rd Semester</td>\n",
    " \n",
    "  </tr>\n",
    "  <tr>\n",
    "   \t<td>Anastasia Siebers</td>\n",
    "    <td>anastasia.siebers@uni-konstanz.de</td>\n",
    "    <td>3rd Semester</td>\n",
    "\n",
    "  </tr>\n",
    "  <tr>\n",
    "    <td>Salma El-Bakry</td>\n",
    "    <td>salma.el-bakry@uni-konstanz.de</td>\n",
    "    <td>3rd Semester</td>\n",
    "  \n",
    "</table>\n",
    "\n",
    "\n",
    "</body>\n",
    "\n",
    "</html>\n",
    "'''"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "afb4277d",
   "metadata": {},
   "outputs": [],
   "source": [
    "html_df = pd.read_html(html_string)\n",
    "html_df[0]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5b12d6ff",
   "metadata": {},
   "outputs": [],
   "source": [
